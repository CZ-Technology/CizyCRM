        "parameters": {
          "jsCode": "const raw = $('GitHub Releases').all().flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\nconst release = raw.find(item =>\n  item && !item.draft && !item.prerelease &&\n  /^v\\d+\\.\\d+\\.\\d+$/.test(item.tag_name || '')\n);\nconst installedRaw = $('Health').first().json?.data?.version || '';\nconst installedMatch = installedRaw.match(/^(\\d+)\\.(\\d+)\\.(\\d+)(?:[-+].*)?$/);\nif (!installedMatch) {\n  throw new Error('A rota de saúde não informou uma versão válida do CRM');\n}\nconst installed = installedMatch.slice(1).map(Number);\nif (!release) return [{ json: { deveAtualizar: false, instalada: installedRaw } }];\nconst target = release.tag_name.slice(1).split('.').map(Number);\nconst deveAtualizar = target[0] > installed[0] ||\n  (target[0] === installed[0] && target[1] > installed[1]) ||\n  (target[0] === installed[0] && target[1] === installed[1] && target[2] > installed[2]);\nreturn [{ json: { deveAtualizar, instalada: installedRaw, targetTag: release.tag_name } }];\n"
        },
